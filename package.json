{
  "name": "acurast-typescript-sdk",
  "version": "1.0.0",
  "author": "Papers AG <contact@papers.ch> (https://papers.ch)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "bump:version": "lerna version --no-git-tag-version",
    "test": "lerna run test --stream",
    "test:ci": "lerna run test:ci",
    "bump:major": "lerna version --no-git-tag-version major --yes",
    "bump:minor": "lerna version --no-git-tag-version minor --yes",
    "bump:patch": "lerna version --no-git-tag-version patch --yes",
    "bump:beta": "lerna version --no-git-tag-version prerelease --preid beta --yes",
    "format": "prettier --write \"packages/*/{src,tests,test}/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"packages/*/{src,tests,test}/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^9.1.7",
    "lerna": "~10.0.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
