{
  "name": "@acurast/devtools",
  "version": "1.1.0",
  "description": "Acurast DevTools client and bundle snippet injection.",
  "author": "Papers AG <contact@papers.ch> (https://papers.ch)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "keywords": [
    "acurast",
    "devtools"
  ],
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.9.0"
  },
  "peerDependencies": {
    "@polkadot/keyring": "^14.0.0",
    "@polkadot/util": "^14.0.0",
    "@polkadot/wasm-crypto": "^7.3.2"
  },
  "devDependencies": {
    "@polkadot/keyring": "^14.0.0",
    "@polkadot/util": "^14.0.0",
    "@polkadot/wasm-crypto": "^7.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "~30.4.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
